OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-5.6-luna
# Optional bearer key required from clients connecting to this gateway.
GATEWAY_API_KEY=
# Set true only when your OpenAI project permits web_search_call.results.
OPENAI_INCLUDE_WEB_SEARCH_RESULTS=false

# Upstream OpenAI HTTP timeout policy. Read timeout is inactivity; request deadline is total wall time.
OPENAI_CONNECT_TIMEOUT_SECONDS=10
OPENAI_READ_TIMEOUT_SECONDS=900
OPENAI_WRITE_TIMEOUT_SECONDS=30
OPENAI_POOL_TIMEOUT_SECONDS=10
OPENAI_REQUEST_DEADLINE_SECONDS=1200
# Bound sockets per worker. Keep-alive defaults to 0 while openai-python #3440 remains unresolved.
OPENAI_MAX_CONNECTIONS=64
OPENAI_MAX_KEEPALIVE_CONNECTIONS=0
# Keep retries explicit. 0 prevents a timed-out long LLM call from repeating for another full timeout window.
OPENAI_MAX_RETRIES=0

# Bound long-lived requests per worker. Excess requests fail fast with 503/gateway_busy.
GATEWAY_MAX_INFLIGHT_REQUESTS=64
# Force Connection: close for SSE until openai-python #3440 is fixed, protecting downstream SDK clients too.
GATEWAY_STREAM_CONNECTION_CLOSE=true

# Uvicorn reads WEB_CONCURRENCY automatically. The container defaults to 2 workers; override as needed.
# WEB_CONCURRENCY=4
